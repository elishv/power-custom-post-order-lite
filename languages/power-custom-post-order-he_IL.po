msgstr "לא נמצאו פוסטים."

msgid "post_id is required"
msgstr "post_id הוא שדה חובה"

msgid "No order provided."
msgstr "לא סופק סדר."

msgid "Order saved."
msgstr "הסדר נשמר."

msgid "Order reset."
msgstr "הסדר אופס."

msgid "Order reversed."
msgstr "הסדר הפוך."

msgid "Shuffled."
msgstr "עורבב."

msgid "Alphabetized."
msgstr "סודר אלפביתית."

msgid "Invalid post type."
msgstr "סוג פוסט לא חוקי."

msgid "Imported: %1$d, Skipped: %2$d, Errors: %3$d"
msgstr "יובא: %1$d, דולג: %2$d, שגיאות: %3$d"
