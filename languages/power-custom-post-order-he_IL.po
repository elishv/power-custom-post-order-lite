# --- Plugin metadata ---
msgid "Power Custom Post Order"
msgstr "סידור פוסטים מתקדם"

msgid "Post Order"
msgstr "סידור פוסטים"

msgid ""
"Drag-and-drop ordering for any post type, with per-taxonomy ordering, sticky"
" / hidden posts, templates, CSV import-export, and a REST API. Works with "
"every theme — including Elementor."
msgstr ""
"סידור בגרירה ושחרור לכל סוג פוסט, כולל סידור לפי טקסונומיה, פוסטים "
"מוצמדים/מוסתרים, תבניות, ייבוא וייצוא CSV, ו-REST API. עובד עם כל תבנית — "
"כולל Elementor."

# --- Common UI ---
msgid "Settings"
msgstr "הגדרות"

msgid "Save"
msgstr "שמירה"

msgid "Saving…"
msgstr "שומר…"

msgid "Saved"
msgstr "נשמר"

msgid "Order saved"
msgstr "הסדר נשמר"

